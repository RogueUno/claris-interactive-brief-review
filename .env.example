# Private Vercel Blob read/write token for a PRIVATE store.
BLOB_READ_WRITE_TOKEN=

# At least 32 characters. Rotate if exposed.
CLARIS_SESSION_SECRET=

# Protects invite creation endpoint.
CLARIS_ADMIN_KEY=

# Public calibration origin used when constructing opaque invite URLs.
CLARIS_CALIBRATION_BASE_URL=https://example.com/calibration-v3/
